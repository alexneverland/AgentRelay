{
  "name": "agent-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test tests/contracts.test.ts tests/mcp.test.ts tests/community-contracts.test.ts tests/client-errors.test.ts tests/bootstrap.test.ts tests/auth-email.test.ts tests/recovery-state.test.ts tests/recovery-sign-out.test.ts tests/auth-fields.test.ts",
    "test:integration": "tsx --env-file=.env.local --test tests/integration.test.ts",
    "test:community": "tsx --env-file=.env.local --test tests/community.integration.test.ts",
    "test:moderation-review": "tsx --env-file=.env.local --test tests/moderation-review.integration.test.ts",
    "test:moderation-rls": "tsx --env-file=.env.local scripts/verify-moderation-schema.ts",
    "check": "npm test && npm run typecheck && npm run build",
    "db:check": "tsx --env-file=.env.local scripts/check-connection.ts",
    "format:check": "prettier --check src tests scripts *.md docs .github package.json tsconfig.json next.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
